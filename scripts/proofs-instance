#!/usr/bin/env python3
"""Writes proofs/PathosProofs for another calculus.

  scripts/proofs-instance [--check]

The hand-written library proofs/PathosProofs is about the store, the runtime
and the generated code of a compiled checker, and names its calculus only
by module: `MiniChecker` (the translated checker), `CpcMini.*` (logos's Lean)
and the generated `Mini*` modules. For the full CPC, proofs-cpc/ has the same
modules under other names (`CpcChecker`, `Cpc.*`, `Cpc*`), and this writes
the library there with its imports renamed, as proofs-cpc/PathosProofs/,
with proofs-cpc/PathosProofs.lean importing it and proofs-cpc/audit/
Axioms.lean auditing it. Nothing else is changed: proofs/PathosProofs stays
the one source, and what is written is not in the repository.

The modules named in proofs-cpc/excluded.txt (one per line, `#` comments)
are left out: those that are CpcMini's (its top-level theorem) and those
that do not build on CPC yet, among them the generated ones (`CpcEmbed`, …),
which the root then does not import either. A module that imports an excluded one must be
excluded too; this says so if it is not.

With --check, writes nothing and exits 1 if the written files would differ
from what is there (scripts/proofs-build --cpc runs it without).
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "proofs"
DST = ROOT / "proofs-cpc"

# The module names of CpcMini and their CPC counterparts.
RENAMES = [
    (r"\bMiniChecker\b", "CpcChecker"),
    (r"\bCpcMini\.", "Cpc."),
    (r"\bMiniCases\b", "CpcCases"),
    (r"\bMiniEmbed\b", "CpcEmbed"),
    (r"\bMiniCtors\b", "CpcCtors"),
    (r"\bMiniCacheSem\b", "CpcCacheSem"),
    (r"\bMiniProofs\b", "CpcProofs"),
]


def rename(text):
    for pat, rep in RENAMES:
        text = re.sub(pat, rep, text)
    return text


# The calculus's Lean: logos's committed files, in proofs/'s packages.
CALC_LEAN = SRC / ".lake" / "packages" / "LogosVerification" / "Cpc"


def calc_defs():
    """The definitions of the calculus's Lean: name -> (namespace, body)."""
    if not CALC_LEAN.is_dir():
        sys.exit(f"scripts/proofs-instance: no {CALC_LEAN} (build proofs/ once, "
                 "or run `lake exe cache get` there, to fetch the packages)")
    defs = {}
    start = re.compile(r"^(?:@\[[^\]]*\]\s*)?(?:(?:noncomputable|partial|private|protected)\s+)*"
                       r"(?:def|abbrev)\s+([^\s:({\[]+)")
    for path in sorted(CALC_LEAN.glob("*.lean")):
        ns, name, body = [], None, []
        for line in path.read_text().splitlines():
            m = re.match(r"namespace\s+(\S+)", line)
            if m:
                ns.append(m.group(1))
                continue
            m = re.match(r"end\s+(\S+)\s*$", line)
            if m and ns and ns[-1] == m.group(1):
                ns.pop()
                continue
            m = start.match(line)
            if m:
                if name and name not in defs:
                    defs[name] = (".".join(namespaces), "\n".join(body))
                name, namespaces, body = m.group(1), list(ns), [line]
            elif name:
                body.append(line)
        if name and name not in defs:
            defs[name] = (".".join(namespaces), "\n".join(body))
    return defs


def qualified(defs, name):
    ns = defs[name][0]
    return f"{ns}.{name}" if ns else name


def requalify_natives(text, defs):
    """Each `<namespace>.native_<x>` of the library, in the namespace the
    calculus's Lean defines `native_<x>` in: lean-meta puts a native in the
    module of its first use, which differs between calculi."""
    def fix(m):
        name = m.group(2)
        return qualified(defs, name) if name in defs else m.group(0)
    return re.sub(r"\b(Eo|Smtm|SmtEval)\.(native_\w+)", fix, text)


# What `logos_eq` unfolds, of what the calculus defines (see
# proofs/PathosProofs/Runtime/CalcSimp.lean).
LOGOS_EQ = ["__eo_and", "__eo_ite", "native_and", "native_ite", "native_teq"]


def calc_simp(defs):
    """Runtime/CalcSimp.lean for the calculus. `eo_list_nil`:
    `__eo_is_list_nil` and what its cases call, transitively (`__eo_*` and
    `native_*`). `eo_logos_eq`: those of LOGOS_EQ that it defines."""
    seen, todo = [], ["__eo_is_list_nil"]
    while todo:
        n = todo.pop(0)
        if n in seen or n not in defs:
            continue
        seen.append(n)
        for m in re.findall(r"\b(__eo_\w+|native_\w+)\b", defs[n][1]):
            if m not in seen and m in defs:
                todo.append(m)
    nil = "\n  ".join(qualified(defs, n) for n in seen)
    eq = "\n  ".join(qualified(defs, n) for n in LOGOS_EQ if n in defs)
    return f"""module
public import Cpc.Logos
import all Cpc.Logos
public import Cpc.SmtEval
import all Cpc.SmtEval
public import PathosProofs.Util

/-!
# The definitions the library unfolds that depend on the calculus, in CPC

Written by scripts/proofs-instance from CPC's Lean (see proofs/PathosProofs/
Runtime/CalcSimp.lean, CpcMini's): `__eo_is_list_nil` and what its cases
call, transitively; the connectives and natives that `logos_eq` unfolds.
-/

attribute [eo_list_nil]
  {nil}

attribute [eo_logos_eq]
  {eq}
"""


def checker_parts():
    """The translated checker's generated functions: name -> the part
    (`generated.part<k>`) that defines it."""
    parts = {}
    for path in sorted((DST / "CpcChecker").glob("Part*.lean")):
        for m in re.finditer(r"^(?:noncomputable |partial )?def (generated\.part\d+)\.(\w+)",
                             path.read_text(), re.M):
            parts.setdefault(m.group(2), m.group(1))
    return parts


def requalify_parts(text, parts):
    """Each `generated.part<k>.<f>` of the library, in the part of the
    calculus's checker that defines `f`: the translation splits the
    generated functions into parts by size, and CpcMini's are all in part 0."""
    def fix(m):
        return f"{parts[m.group(2)]}.{m.group(2)}" if m.group(2) in parts else m.group(0)
    return re.sub(r"\b(generated\.part\d+)\.(\w+)", fix, text)


def natives_layer():
    """scripts/natives-layer, as a module (it writes the bridge modules)."""
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("natives_layer", str(ROOT / "scripts" / "natives-layer"))
    spec = importlib.util.spec_from_loader("natives_layer", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def excluded():
    names = set()
    for line in (DST / "excluded.txt").read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            names.add(line)
    return names


def imports(text):
    """The modules `text` imports, under their CPC names."""
    return re.findall(r"^(?:public )?import (?:all )?([A-Za-z0-9_.]+)", rename(text), re.M)


def main():
    check = "--check" in sys.argv[1:]
    skip = excluded()
    defs = calc_defs()
    parts = checker_parts()
    files = {}
    modules = []
    for path in sorted((SRC / "PathosProofs").rglob("*.lean")):
        rel = path.relative_to(SRC)
        mod = ".".join(rel.with_suffix("").parts)
        if mod in skip:
            continue
        text = path.read_text()
        bad = [m for m in imports(text) if m in skip]
        if bad:
            sys.exit(f"scripts/proofs-instance: {mod} imports {', '.join(bad)}, which "
                     "proofs-cpc/excluded.txt leaves out; leave it out too")
        files[rel] = requalify_parts(requalify_natives(rename(text), defs), parts)
        if mod == "PathosProofs.Runtime.CalcSimp":
            files[rel] = calc_simp(defs)
        if mod == "PathosProofs.Generated" and (DST / "PathosProofsCpc.lean").exists():
            # the CPC-only specs (proofs-cpc/PathosProofsCpc), for the
            # generated proofs
            files[rel] = files[rel].replace("module\n", "module\npublic import PathosProofsCpc\n", 1)
        if mod == "PathosProofs.Eunoia.Bridge":
            files[rel] = natives_layer().bridge_for(
                "CPC", CALC_LEAN, ["Cpc.Logos", "Cpc.SmtEval", "Cpc.SmtModel"])
        modules.append(mod)
    # The root: what proofs/PathosProofs.lean imports, but the excluded.
    root = []
    for line in (SRC / "PathosProofs.lean").read_text().splitlines(keepends=True):
        m = re.match(r"(?:public )?import (\S+)", rename(line))
        if m and m.group(1) in skip:
            continue
        root.append(line)
    files[Path("PathosProofs.lean")] = rename("".join(root))
    files[Path("audit/Axioms.lean")] = rename((SRC / "audit" / "Axioms.lean").read_text())
    # What is there and should not be: a module excluded since.
    stale = [p.relative_to(DST) for p in (DST / "PathosProofs").rglob("*.lean")
             if p.relative_to(DST) not in files] if (DST / "PathosProofs").exists() else []
    differs = [p for p, t in files.items() if not (DST / p).exists() or (DST / p).read_text() != t]
    if check:
        for p in differs + stale:
            print(f"scripts/proofs-instance: proofs-cpc/{p} is not what this writes")
        sys.exit(1 if differs or stale else 0)
    for p in stale:
        (DST / p).unlink()
    for p, t in files.items():
        (DST / p).parent.mkdir(parents=True, exist_ok=True)
        if not (DST / p).exists() or (DST / p).read_text() != t:
            (DST / p).write_text(t)
    print(f"proofs-instance: proofs-cpc/PathosProofs: {len(modules)} modules "
          f"({len(skip)} left out, proofs-cpc/excluded.txt)")


if __name__ == "__main__":
    main()
