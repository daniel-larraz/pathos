#!/usr/bin/env python3
"""Checks what the theorems of proofs/PathosProofs rest on.

  scripts/proofs-axioms [--cpc]

With --cpc, the same for proofs-cpc/ (the full CPC), whose checker is
CpcChecker; the allowed axioms are the same list.

Runs proofs/audit/Axioms.lean in the built project (`lake lean`), which
collects the axioms of every theorem of the modules PathosProofs.* other
than Trusted, and compares them with proofs/axioms-allowed.txt. Exits 1 if

  - a theorem uses an axiom that the file does not list (`sorryAx`, which
    a `sorry` leaves, is never listed);
  - the file's [MiniChecker] section is not exactly the axioms that
    proofs/MiniChecker declares, or its [Trusted] section not exactly those
    of proofs/PathosProofs/Trusted.lean: the file is the statement of what
    is trusted, so it must not fall behind either.

Prints the number of theorems, the assumptions in use (axioms whose type is
a proposition, and Lean's three), the number of declarations in use (axioms
that declare a type or a function: Aeneas's for the Rust it does not
translate, and Trusted.lean's ℤ and ℚ, with no property), and the axioms in
use by section. Also exits 1 if an axiom of the [MiniChecker] or [Aeneas]
section that is a proposition is in use: those are to declare, not to
assume. The
project must be built (scripts/proofs-build does that, and runs this).
Needs elan (lake) and Python 3.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROOFS = ROOT / "proofs"
# The project audited: proofs/ (CpcMini), or with --cpc proofs-cpc/ (the full
# CPC), whose checker is CpcChecker. The allowed axioms are one list,
# proofs/axioms-allowed.txt, whose [MiniChecker] section is the axioms the
# translated runtime declares, the same for both checkers.
CPC = "--cpc" in sys.argv[1:]
PROJECT = ROOT / "proofs-cpc" if CPC else PROOFS
CHECKER = "CpcChecker" if CPC else "MiniChecker"
NS = "pathos_compiled_checker"


def fail(msg):
    print(f"scripts/proofs-axioms: {msg}", file=sys.stderr)
    sys.exit(2)


def allowed():
    sections, current = {}, None
    for line in (PROOFS / "axioms-allowed.txt").read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.fullmatch(r"\[(\w+)\]", line)
        if m:
            current = sections.setdefault(m.group(1), [])
        elif current is None:
            fail(f"axioms-allowed.txt: {line} is in no section")
        else:
            current.append(line)
    return sections


def declared(paths, namespace):
    """The axioms that Lean files declare, with the namespaces they are in."""
    names = set()
    for path in paths:
        stack = [namespace] if namespace else []
        for line in path.read_text().splitlines():
            m = re.match(r"namespace\s+(\S+)", line)
            if m:
                stack.append(m.group(1))
                continue
            m = re.match(r"end\s+(\S+)\s*$", line)
            if m and stack and stack[-1] == m.group(1):
                stack.pop()
                continue
            m = re.match(r"axiom\s+(\S+)", line)
            if m:
                names.add(".".join(stack + [m.group(1)]))
    return names


def main():
    sections = allowed()
    problems = []
    mini = declared(sorted((PROJECT / CHECKER).glob("*.lean")), None)
    trusted = declared([PROOFS / "PathosProofs" / "Trusted.lean"], None)
    for name, have in (("MiniChecker", mini), ("Trusted", trusted)):
        listed = set(sections.get(name, []))
        for a in sorted(have - listed):
            problems.append(f"[{name}] does not list {a}, which is declared")
        for a in sorted(listed - have):
            problems.append(f"[{name}] lists {a}, which is not declared")
    env = dict(os.environ)
    if not any((Path(p) / "lake").exists() for p in env.get("PATH", "").split(":")):
        env["PATH"] = f"{Path.home()}/.elan/bin:" + env.get("PATH", "")
    run = subprocess.run(["lake", "lean", "audit/Axioms.lean"], cwd=PROJECT, env=env,
                         capture_output=True, text=True)
    if run.returncode != 0:
        sys.stderr.write(run.stdout[-2000:] + run.stderr[-2000:])
        fail(f"{PROJECT.name}/audit/Axioms.lean failed (is the project built?)")
    kinds = dict(re.findall(r"^axiom (\S+) (assumption|declaration)$", run.stdout, re.M))
    used = list(kinds)
    props = set(re.findall(r"^prop (\S+)$", run.stdout, re.M))
    count = re.search(r"^theorems (\d+)$", run.stdout, re.M)
    if not count:
        fail("proofs/audit/Axioms.lean printed no count of theorems")
    where = {a: s for s, names in sections.items() for a in names}
    by_section = {}
    for a in used:
        if a not in where:
            problems.append(f"a theorem uses the axiom {a}, which axioms-allowed.txt does not list")
        else:
            by_section.setdefault(where[a], []).append(a)
    # An assumption is an axiom whose type is a proposition, and Lean's own
    # three: Classical.choice is a function (`Nonempty α → α`), but it is
    # the axiom of choice.
    lean = set(sections.get("Lean", []))
    assumptions = [a for a in used if kinds[a] == "assumption" or a in lean]
    print(f"proofs-axioms: {count.group(1)} theorems of PathosProofs; they rest on "
          f"{len(assumptions)} assumptions (axioms that are propositions, and Lean's), and use "
          f"{len(used) - len(assumptions)} declarations (axioms that declare a type or "
          f"a function, with no property)")
    print("  assumptions: " + ", ".join(a.removeprefix(NS + ".") for a in sorted(assumptions)))
    # The Lean of the checker and Aeneas's library are to declare, not to
    # assume: an axiom of theirs that is a proposition must not be in use.
    for s in ("MiniChecker", "Aeneas"):
        for a in sections.get(s, []):
            if a in props and a in kinds:
                problems.append(f"[{s}] {a} is a proposition (an assumption) and is in use")
            elif a in props:
                print(f"  note: [{s}] {a.removeprefix(NS + '.')} is a proposition; "
                      "it is listed and not in use")
    for s in sections:
        names = by_section.get(s, [])
        print(f"  [{s}] {len(names)} of {len(sections[s])} listed"
              + (": " + ", ".join(n.removeprefix(NS + ".") for n in names) if names else ""))
    for p in problems:
        print(f"proofs-axioms: {p}", file=sys.stderr)
    if problems:
        return 1
    print("proofs-axioms: no sorry, and no axiom outside proofs/axioms-allowed.txt")
    return 0


if __name__ == "__main__":
    sys.exit(main())
