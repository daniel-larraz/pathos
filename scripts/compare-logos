#!/usr/bin/env python3
"""Runs pathos and logos on the cvc5 proofs and lists where their verdicts
differ; with --perf, also times them against pathos-eo and Ethos.

  scripts/compare-logos [--perf] [--large] [--filter TEXT] [--jobs N]
                        [--timeout SECONDS] [--memory SIZE]
                        [--logos BIN] [--ethos BIN] [--pathos BIN]
                        [--report FILE]

  (default)   the 400 proofs of the harness's corpus
  --large     the 43 large proofs instead (one at a time unless --jobs)
  --perf      also run pathos-eo, pathos-eo with a snapshot of CPC, and
              Ethos, one process at a time, and report time and peak memory
  --filter    only the proofs whose name contains TEXT
  --jobs      processes at a time (default 4; always 1 with --perf)
  --timeout   seconds per run (default 120; LARGE_TIMEOUT of difftest.env
              with --large)
  --memory    the cap on each run (default 8G)
  --logos     the logos binary (default: the harness's build at LOGOS_REV,
              $ETHOS_HARNESS/tools/difftest/work/logos/.lake/build/bin/logos;
              build one with scripts/build.sh logos in a logos checkout)
  --ethos     the Ethos binary (default: the harness's build of
              REFERENCE_REV)
  --pathos    the pathos binary (default: target/release/pathos, built
              first with cargo)
  --report    write every run as JSON to FILE

Every run of every binary is under the memory cap (systemd-run --user
--scope -p MemoryMax=... -p MemorySwapMax=0) and the time limit.

A verdict is the last line a checker prints: correct, incorrect or
incomplete. Anything else is "error" (the checker could not read the
proof), "timeout" or "memory". Exits 0 if pathos and logos agree on every
proof and pathos says correct only where Ethos (when run) accepts the
proof, 1 otherwise, 2 if the setup is wrong.
"""

import argparse
import concurrent.futures
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VERDICTS = ("correct", "incorrect", "incomplete")


def fail(msg):
    print(f"scripts/compare-logos: {msg}", file=sys.stderr)
    sys.exit(2)


def read_env():
    env = {}
    for name in ("difftest.env", ".difftest.local"):
        path = ROOT / name
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                env[key] = value
    if os.environ.get("ETHOS_HARNESS"):
        env["ETHOS_HARNESS"] = os.environ["ETHOS_HARNESS"]
    return env


def run(cmd, cwd, timeout, memory):
    """One capped run: verdict, seconds, peak memory in KiB, first line of
    the error output."""
    with tempfile.NamedTemporaryFile("r", suffix=".time") as timing:
        full = [
            "systemd-run", "--user", "--scope", "-q",
            "-p", f"MemoryMax={memory}", "-p", "MemorySwapMax=0",
            "/usr/bin/time", "-f", "%e %M", "-o", timing.name,
            "timeout", "--signal=KILL", str(timeout),
        ] + cmd
        p = subprocess.run(full, cwd=cwd, capture_output=True, errors="replace")
        fields = timing.read().split()
    # /usr/bin/time writes a line of its own first when the command was
    # killed; the two numbers are the last fields either way
    try:
        seconds, peak = float(fields[-2]), int(fields[-1])
    except (IndexError, ValueError):
        seconds, peak = None, None
    out = p.stdout.strip().splitlines()
    err = [l for l in p.stderr.strip().splitlines() if not l.startswith("Fatal failure within")]
    last = out[-1].strip() if out else ""
    if seconds is not None and seconds >= timeout:
        verdict = "timeout"
    elif last in VERDICTS:
        verdict = last
    elif p.returncode in (137, -9) or "Killed" in p.stderr:
        verdict = "memory"
    else:
        verdict = "error"
    return {
        "verdict": verdict,
        "seconds": seconds,
        "peak_kib": peak,
        "exit": p.returncode,
        "note": (err[0] if err else "")[:300],
    }


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--help", action="store_true")
    ap.add_argument("--perf", action="store_true")
    ap.add_argument("--large", action="store_true")
    ap.add_argument("--filter", default="")
    ap.add_argument("--jobs", type=int, default=4)
    ap.add_argument("--timeout", type=int)
    ap.add_argument("--memory", default="8G")
    ap.add_argument("--logos")
    ap.add_argument("--ethos")
    ap.add_argument("--pathos")
    ap.add_argument("--report")
    args = ap.parse_args()
    if args.help:
        print(__doc__)
        return 0
    for tool in ("systemd-run", "timeout"):
        if not shutil.which(tool):
            fail(f"{tool} is needed for the memory cap and the time limit")
    env = read_env()
    harness = env.get("ETHOS_HARNESS")
    if not harness:
        fail("set ETHOS_HARNESS (see scripts/difftest)")
    work = Path(harness) / "tools/difftest/work"
    corpus = work / ("corpus-large" if args.large else "corpus")
    proofs = sorted(p for p in (corpus / "proofs").glob("*.cpc") if args.filter in p.name)
    if not proofs:
        fail(f"no proofs in {corpus}/proofs (the harness's gen-proofs makes them)")
    timeout = args.timeout or (int(env.get("LARGE_TIMEOUT", 1800)) if args.large else 120)

    logos = Path(args.logos) if args.logos else work / "logos/.lake/build/bin/logos"
    if not logos.exists():
        fail(f"no logos binary at {logos}; build logos at {env.get('LOGOS_REV')} and pass --logos")
    if args.pathos:
        pathos = Path(args.pathos)
        pathos_eo = pathos.parent / "pathos-eo"
    else:
        built = subprocess.run(
            ["systemd-run", "--user", "--scope", "-q", "-p", "MemoryMax=16G", "-p", "MemorySwapMax=0",
             "cargo", "build", "--locked", "--release", "--quiet", "--bin", "pathos", "--bin", "pathos-eo"],
            cwd=ROOT)
        if built.returncode != 0:
            fail("cargo build failed")
        pathos = ROOT / "target/release/pathos"
        pathos_eo = ROOT / "target/release/pathos-eo"

    checkers = {"pathos": [str(pathos)], "logos": [str(logos)]}
    if args.perf:
        ethos = Path(args.ethos) if args.ethos else (
            work / "ref" / env.get("REFERENCE_REV", "")[:12] / "build/src/ethos")
        if not ethos.exists():
            fail(f"no Ethos binary at {ethos}; pass --ethos")
        # A snapshot of the signature the proofs include, for pathos-eo.
        snap_dir = ROOT / "target/compare-logos"
        snap_dir.mkdir(parents=True, exist_ok=True)
        snapshot = snap_dir / "Cpc.snapshot"
        made = subprocess.run(
            [str(pathos_eo), f"--write-snapshot={snapshot}", str(corpus / "cpc/Cpc.eo")])
        if made.returncode != 0:
            fail("pathos-eo could not write a snapshot of the corpus's Cpc.eo")
        checkers["pathos-eo"] = [str(pathos_eo)]
        checkers["pathos-eo --snapshot"] = [str(pathos_eo), f"--snapshot={snapshot}"]
        checkers["ethos"] = [str(ethos)]
    jobs = 1 if args.perf else max(1, args.jobs)

    def check(proof):
        return proof.name, {
            name: run(cmd + [proof.name], proof.parent, timeout, args.memory)
            for name, cmd in checkers.items()
        }

    results = {}
    with concurrent.futures.ThreadPoolExecutor(jobs) as pool:
        for i, (name, r) in enumerate(pool.map(check, proofs), 1):
            results[name] = r
            if sys.stderr.isatty():
                print(f"\r{i}/{len(proofs)}", end="", file=sys.stderr)
    if sys.stderr.isatty():
        print(file=sys.stderr)

    if args.report:
        Path(args.report).write_text(json.dumps(results, indent=1))

    def tally(name):
        counts = {}
        for r in results.values():
            v = r[name]["verdict"]
            counts[v] = counts.get(v, 0) + 1
        return ", ".join(f"{k} {counts[k]}" for k in sorted(counts))

    print(f"{len(proofs)} proofs from {corpus}/proofs; cap {args.memory}, {timeout} s per run")
    for name in checkers:
        print(f"  {name}: {tally(name)}")

    differ = [(n, r) for n, r in results.items() if r["pathos"]["verdict"] != r["logos"]["verdict"]]
    print(f"\npathos and logos differ on {len(differ)} proofs")
    kinds = {}
    for n, r in differ:
        key = (r["pathos"]["verdict"], r["logos"]["verdict"])
        kinds.setdefault(key, []).append((n, r))
    for (pv, lv), cases in sorted(kinds.items()):
        print(f"\n  pathos {pv}, logos {lv}: {len(cases)}")
        for n, r in cases:
            note = r["pathos"]["note"] or r["logos"]["note"]
            print(f"    {n}" + (f"  [{note}]" if note else ""))

    unsound = []
    if args.perf:
        unsound = [n for n, r in results.items()
                   if r["pathos"]["verdict"] == "correct" and r["ethos"]["verdict"] != "correct"]
        print(f"\npathos says correct where Ethos does not: {len(unsound)}")
        for n in unsound:
            print(f"    {n} (Ethos: {results[n]['ethos']['verdict']})")

        print("\ntime and peak memory, over the proofs every checker gave a verdict on "
              "(and over all runs):")
        common = [r for r in results.values()
                  if all(r[c]["verdict"] in VERDICTS for c in checkers)]
        print(f"  {len(common)} such proofs")
        for name in checkers:
            def total(rs, key):
                return sum(r[name][key] or 0 for r in rs)
            peak = max((r[name]["peak_kib"] or 0 for r in results.values()), default=0)
            print(f"  {name}: {total(common, 'seconds'):.1f} s "
                  f"({total(results.values(), 'seconds'):.1f} s over all), "
                  f"largest peak {peak / 1048576:.2f} GiB")
        slow = []
        for n, r in results.items():
            a, b = r["pathos"]["seconds"], r["pathos-eo"]["seconds"]
            if a is not None and b is not None and a > 2 * b and a - b > 0.5:
                slow.append((a / max(b, 0.01), n, a, b))
        print(f"\npathos more than twice as slow as pathos-eo (and by more than 0.5 s): {len(slow)}")
        for ratio, n, a, b in sorted(slow, reverse=True):
            print(f"    {n}: {a:.1f} s against {b:.1f} s ({results[n]['pathos']['verdict']})")

    return 1 if differ or unsound else 0


if __name__ == "__main__":
    sys.exit(main())
