#!/usr/bin/env bash
# Regenerates generated/cpc-checker, the checker for CPC that Ethos's
# rust-meta stage (cvc5/ethos#274, merged) compiles from logos's signature. The
# crate is generated code: it is never edited by hand, and this script is
# the only thing that writes it.
#
#   scripts/generate-cpc [--ethos REPO] [--rev COMMIT] [--logos REPO]
#                        [--logos-rev REV] [--work DIR] [--check]
#                        [--from-note] [--mini]
#
#   --mini       generate generated/cpcmini-checker instead: the checker for
#                CpcMini, logos's reduced calculus (see below; this is what
#                scripts/generate-mini runs)
#   --ethos      the Ethos repository holding the commit, a URL or a local
#                clone (default: https://github.com/cvc5/ethos)
#   --rev        the Ethos commit with the rust-meta stage (default: the
#                one below, a commit of Ethos's main branch)
#   --logos      the logos repository (default: LOGOS_REPO of difftest.env)
#   --logos-rev  the logos revision whose install/defs is compiled
#                (default: LOGOS_REV of difftest.env)
#   --work       where to clone and build (default: target/generate-cpc;
#                kept between runs)
#   --check      do not write generated/cpc-checker: generate, and say
#                whether the result is what the repository holds (exit 1 if
#                it is not)
#   --from-note  take the Ethos commit and the logos revision from
#                generated/cpc-checker/GENERATED.md, the ones the crate says
#                it was generated from (with --check: is it?). Without
#                --ethos, the Ethos commit is looked for in cvc5/ethos and
#                then in HARNESS_REPO of difftest.env, which holds the
#                branches of work not yet merged upstream
#
# It builds ethos-eoc at that commit and runs, as the stage's README says,
#
#   tools/eoc/driver.py rust --semantics <logos>/install/defs/Cpc.eos \
#     --smt-semantics <logos>/install/defs/smt.eos \
#     <logos>/install/defs/Cpc.cached.eo
#
# then copies the crate the driver writes, without its build directory,
# with the signature beside it (Cpc.cached.eo, which crates/pathos builds
# in), and records in generated/cpc-checker/GENERATED.md what it was
# generated from.
#
# With --mini it generates the checker for CpcMini, the calculus of five
# rules that logos develops its proofs on, for the proofs of proofs/. logos
# has no signature file for CpcMini: its install/install-sig.sh --mini
# compiles Cpc.cached.eo with
#
#   tools/eoc/driver.py lean ... --no-parser --calc-name CpcMini \
#     Cpc.cached.eo <the rules>
#
# whose first stage (trim-defs) writes the signature reduced to those rules.
# This script runs that command with the rules install-sig.sh names, checks
# that the Lean it writes is logos's CpcMini at that revision (so that the
# Rust and the Lean the proofs relate come from one signature and one
# compiler), and then runs `driver.py rust` on the reduced signature. The
# defaults differ: Ethos and logos at the revisions below (MINI_...), the
# crate in generated/cpcmini-checker with the reduced signature beside it as
# CpcMini.eo, the work in target/generate-mini.
#
# Needs git, cmake, a C++ compiler, GMP and Python 3. Every step that can
# use much memory runs under a cap (CPC_MEMORY_MAX, default 8G) where
# systemd-run is available.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../difftest.env
source "$root/difftest.env"

# The commit of Ethos's main branch the checker is generated from.
default_rev=b02afbe66a4f796043ed3c5b9790cb6e7f00b9cc

# The same for --mini: a commit of the fork (branch m32-proofs: Ethos main,
# whose generator Charon and Aeneas translate since cvc5/ethos#280, and on it
# the one that writes the proofs), and the logos revision whose CpcMini the
# proofs are about. proofs/ pins the same logos revision.
mini_default_rev=f90d6dd45b16679cbe251a8dac92558669983c4a
mini_logos_rev=cf18742973861b3718d04c5f25775448098ff474

me=generate-cpc
fail() { echo "scripts/$me: $*" >&2; exit 2; }

ethos_repo=https://github.com/cvc5/ethos
ethos_given=false
rev="$default_rev"
logos_repo="$LOGOS_REPO"
logos_rev="$LOGOS_REV"
work=""
check=false
from_note=false
mini=false
rev_given=false
logos_rev_given=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ethos) ethos_repo="$2"; ethos_given=true; shift 2 ;;
    --rev) rev="$2"; rev_given=true; shift 2 ;;
    --logos) logos_repo="$2"; shift 2 ;;
    --logos-rev) logos_rev="$2"; logos_rev_given=true; shift 2 ;;
    --work) work="$2"; shift 2 ;;
    --check) check=true; shift ;;
    --from-note) from_note=true; shift ;;
    --mini) mini=true; shift ;;
    *) fail "unknown argument: $1 (see the header of this script)" ;;
  esac
done
name=cpc-checker
if $mini; then
  me=generate-mini
  name=cpcmini-checker
  default_rev="$mini_default_rev"
  $rev_given || rev="$mini_default_rev"
  $logos_rev_given || logos_rev="$mini_logos_rev"
  # The default Ethos commit is on the fork, not yet upstream.
  $ethos_given || ethos_repo="$HARNESS_REPO"
  default_logos_rev="$mini_logos_rev"
else
  default_logos_rev="$LOGOS_REV"
fi
[[ -n "$work" ]] || work="$root/target/$me"

capped() {
  if command -v systemd-run >/dev/null 2>&1 && systemd-run --user --scope -q true 2>/dev/null; then
    systemd-run --user --scope -q -p "MemoryMax=${CPC_MEMORY_MAX:-8G}" -p MemorySwapMax=0 "$@"
  else
    "$@"
  fi
}

ethos_repos=("$ethos_repo")
if $from_note; then
  note="$root/generated/$name/GENERATED.md"
  [[ -f "$note" ]] || fail "--from-note: there is no $note"
  # The table rows `| Ethos (...) | `<commit>` |` and `| logos (...) | `<commit>` |`.
  rev="$(sed -n 's/^| Ethos (.*| `\([0-9a-f]\{40\}\)` |$/\1/p' "$note")"
  logos_rev="$(sed -n 's/^| logos (.*| `\([0-9a-f]\{40\}\)` |$/\1/p' "$note")"
  [[ -n "$rev" && -n "$logos_rev" ]] || fail "--from-note: no Ethos and logos commits in $note"
  $ethos_given || ethos_repos+=("$HARNESS_REPO")
  [[ "$rev" == "$default_rev" ]] ||
    echo "$me: note: the crate is generated from Ethos $rev, not this script's default $default_rev"
  [[ "$logos_rev" == "$default_logos_rev" ]] ||
    echo "$me: note: the crate is generated from logos $logos_rev, not $default_logos_rev"
fi

mkdir -p "$work"
work="$(cd "$work" && pwd)"

# A clone of `repo` in `dir` at `rev`; prints the commit. `dir` is used only
# if git says it is the top of a repository of its own (see scripts/drift).
checkout() {
  local repo="$1" dir="$2" rev="$3"
  local top
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || top=""
  if [[ ! -d "$dir" || "$(cd "$dir" && pwd -P)" != "$top" ]]; then
    rm -rf "$dir"
    git clone --quiet "$repo" "$dir" || return 1
  fi
  git -C "$dir" remote set-url origin "$repo" || return 1
  git -C "$dir" fetch --quiet --tags origin '+refs/heads/*:refs/remotes/origin/*' || return 1
  local commit
  if ! commit="$(git -C "$dir" rev-parse --verify --quiet "origin/$rev^{commit}" ||
    git -C "$dir" rev-parse --verify --quiet "$rev^{commit}")"; then
    # a commit that is on no branch
    git -C "$dir" fetch --quiet origin "$rev" 2>/dev/null || return 1
    commit="$(git -C "$dir" rev-parse --verify --quiet "$rev^{commit}")" || return 1
  fi
  git -C "$dir" checkout --quiet --detach "$commit" || return 1
  echo "$commit"
}

ethos_commit=""
for ethos_repo in "${ethos_repos[@]}"; do
  ethos_commit="$(checkout "$ethos_repo" "$work/ethos" "$rev")" && break
  ethos_commit=""
done
[[ -n "$ethos_commit" ]] || fail "cannot get commit $rev of ${ethos_repos[*]}"
logos_commit="$(checkout "$logos_repo" "$work/logos" "$logos_rev")" ||
  fail "cannot get revision $logos_rev of $logos_repo"
defs="$work/logos/install/defs"
for f in Cpc.cached.eo Cpc.eos smt.eos; do
  [[ -f "$defs/$f" ]] || fail "logos at $logos_commit has no install/defs/$f"
done

out="$work/out"
rm -rf "$out"
echo "$me: Ethos $ethos_commit, logos $logos_commit"
signature="$defs/Cpc.cached.eo"
: > "$work/driver.log"
if $mini; then
  # The rules of install-sig.sh --mini, read from that script.
  sig_script="$work/logos/install/install-sig.sh"
  rules="$(sed -n 's/^ *RULES=(\([a-z_ ]*\))$/\1/p' "$sig_script" 2>/dev/null)"
  [[ -n "$rules" && "$(wc -l <<< "$rules")" -eq 1 ]] ||
    fail "cannot read the rules of --mini from logos's install/install-sig.sh"
  lean_out="$work/lean-out"
  rm -rf "$lean_out"
  # shellcheck disable=SC2086  # the rules are separate arguments
  (cd "$work/ethos" && capped python3 tools/eoc/driver.py lean \
    --build-dir "$work/build-eoc" --final-out-dir "$lean_out" \
    --semantics "$defs/Cpc.eos" --smt-semantics "$defs/smt.eos" \
    --skip-cvc5 --no-parser --calc-name CpcMini \
    "$defs/Cpc.cached.eo" $rules) >> "$work/driver.log" 2>&1 ||
    { tail -n 30 "$work/driver.log" >&2; fail "the driver failed; see $work/driver.log"; }
  signature="$lean_out/lean-cpc-trim.eo"
  [[ -f "$signature" ]] || fail "the driver wrote no reduced signature $signature"
  # The Lean of this run against logos's CpcMini: logos's files have a
  # header of comment lines before `module` and `def` for `partial def`.
  compared=0
  : > "$work/lean.diff"
  for f in "$lean_out"/lean/*.lean; do
    theirs="$work/logos/CpcMini/$(basename "$f")"
    [[ -f "$theirs" ]] || fail "logos at $logos_commit has no CpcMini/$(basename "$f")"
    diff <(sed 's/partial def /def /g' "$f") <(awk 'NR==1 && /^--/ {h=1} h && /^--/ {next} h && /^$/ {h=0; next} {h=0; print}' "$theirs") \
      >> "$work/lean.diff" || true
    compared=$((compared + 1))
  done
  if [[ -s "$work/lean.diff" || "$compared" -eq 0 ]]; then
    head -n 20 "$work/lean.diff" >&2
    fail "the Lean this Ethos writes for CpcMini is not logos's CpcMini at $logos_commit ($work/lean.diff)"
  fi
  echo "$me: rules $rules; the $compared Lean files are logos's CpcMini"
  # The cases of the programs as functions (lean-meta writes the file with
  # the others; the driver leaves it in its build directory), before the
  # next run of the driver writes there.
  case_defs="$work/build-eoc/out/plugins/lean_meta/lean_meta_case_defs_gen.lean"
  [[ -f "$case_defs" ]] || fail "the driver wrote no $case_defs"
  cp "$case_defs" "$work/case_defs.lean"
fi
(cd "$work/ethos" && capped python3 tools/eoc/driver.py rust \
  --build-dir "$work/build-eoc" --final-out-dir "$out" \
  --semantics "$defs/Cpc.eos" --smt-semantics "$defs/smt.eos" \
  "$signature") >> "$work/driver.log" 2>&1 ||
  { tail -n 30 "$work/driver.log" >&2; fail "the driver failed; see $work/driver.log"; }
[[ -f "$out/rust/Cargo.toml" && -f "$out/rust/src/generated.rs" ]] ||
  fail "the driver wrote no crate in $out/rust; see $work/driver.log"

# The crate as the repository holds it: the driver's files and the note.
staged="$work/staged"
rm -rf "$staged"
mkdir -p "$staged"
(cd "$out/rust" && find . -path ./target -prune -o -type f -print0 |
  while IFS= read -r -d '' f; do
    mkdir -p "$staged/$(dirname "$f")"
    cp "$f" "$staged/$f"
  done)
# The signature the crate was compiled from: the front end of crates/pathos
# reads proofs against it.
if $mini; then
cp "$signature" "$staged/CpcMini.eo"
cat > "$staged/GENERATED.md" <<EOF
# generated/cpcmini-checker

Generated code. Do not edit it: change what it is generated from and run
\`scripts/generate-mini\`, which wrote every file here, this one included.

It is the checker for CpcMini, the calculus of a few rules that logos
develops its proofs on, compiled by the \`rust-meta\` stage of
\`ethos-eoc\` as \`generated/cpc-checker\` is for CPC. Nothing in pathos
links it: it is what the proofs of \`proofs/\` are about, through the Lean
that Charon and Aeneas write for it.

| Generated from | |
| --- | --- |
| Ethos (\`ethos-eoc\`, \`tools/eoc/driver.py\`, the runtime in \`plugins/rust_meta/runtime\`) | \`$ethos_commit\` |
| logos (\`install/defs/Cpc.cached.eo\`, with \`Cpc.eos\` as \`--semantics\` and \`smt.eos\` as \`--smt-semantics\`) | \`$logos_commit\` |
| Rules (those of logos's \`install/install-sig.sh --mini\`) | \`$rules\` |

\`CpcMini.eo\` is the signature reduced to those rules, as the first stage
of \`driver.py lean ... Cpc.cached.eo $rules\` writes it; the crate is
\`driver.py rust\` on that file. When it was generated, the Lean that the
same command writes was compared with logos's \`CpcMini/\` at that
revision and found the same, so the crate and logos's CpcMini are compiled
from one signature by one compiler.

It is a workspace of its own (see its \`Cargo.toml\`), outside pathos's
workspace, so pathos's lints, formatting and tests do not apply to it.
EOF
else
cp "$defs/Cpc.cached.eo" "$staged/Cpc.cached.eo"
cat > "$staged/GENERATED.md" <<EOF
# generated/cpc-checker

Generated code. Do not edit it: change what it is generated from and run
\`scripts/generate-cpc\`, which wrote every file here, this one included.

It is the crate \`pathos-compiled-checker\`: the checker for CPC that the
\`rust-meta\` stage of \`ethos-eoc\` (cvc5/ethos#274) compiles from
logos's signature. \`crates/pathos\` builds its input and calls it.

| Generated from | |
| --- | --- |
| Ethos (\`ethos-eoc\`, \`tools/eoc/driver.py rust\`, the runtime in \`plugins/rust_meta/runtime\`) | \`$ethos_commit\` |
| logos (\`install/defs/Cpc.cached.eo\`, with \`Cpc.eos\` as \`--semantics\` and \`smt.eos\` as \`--smt-semantics\`) | \`$logos_commit\` |

\`Cpc.cached.eo\` is a copy of that signature: \`crates/pathos\` builds it in
and reads proofs against it, so that the names it gives the checker are the
names the checker was compiled with.

It is a workspace of its own (see its \`Cargo.toml\`), outside pathos's
workspace, so pathos's lints, formatting and tests do not apply to it.
EOF
fi

# The Lean that is generated with the crate, for proofs/: the cases of the
# programs (lean-meta), and what the cache of results holds and the proofs
# about the generated functions (rust-meta, beside the crate). They name the
# modules they import by placeholders, which are filled in here.
lean_files=()
if $mini; then
  lean_staged="$work/staged-lean"
  rm -rf "$lean_staged"
  mkdir -p "$lean_staged"
  fill() { sed -e 's/\$CHECKER\$/MiniChecker/g; s/\$EO_CALC\$/CpcMini/g; s/\$CALC\$/CpcMini/g; s/\$CASES\$/MiniCases/g' "$1" > "$2"; }
  for f in proofs.lean cache_sem.lean proofs.tsv; do
    [[ -f "$out/rust/$f" ]] || fail "the driver wrote no $f beside the crate"
  done
  fill "$work/case_defs.lean" "$lean_staged/MiniCases.lean"
  fill "$out/rust/proofs.lean" "$lean_staged/MiniProofs.lean"
  fill "$out/rust/cache_sem.lean" "$lean_staged/MiniCacheSem.lean"
  lean_files=(MiniCases.lean MiniProofs.lean MiniCacheSem.lean)
fi

dest="$root/generated/$name"
if $check; then
  : > "$work/check.diff"
  same=true
  diff -r "$staged" "$dest" >> "$work/check.diff" 2>&1 || same=false
  for f in "${lean_files[@]}"; do
    diff "$lean_staged/$f" "$root/proofs/$f" >> "$work/check.diff" 2>&1 || same=false
  done
  if $same; then
    echo "$me: generated/$name${lean_files:+ and proofs/{${lean_files[*]}\}} are what these revisions generate"
    exit 0
  fi
  head -n 20 "$work/check.diff"
  echo "$me: generated/$name${lean_files:+ or its Lean in proofs/} differs (the whole difference: $work/check.diff)"
  exit 1
fi
rm -rf "$dest"
mkdir -p "$(dirname "$dest")"
cp -r "$staged" "$dest"
for f in "${lean_files[@]}"; do
  cp "$lean_staged/$f" "$root/proofs/$f"
done
echo "$me: wrote generated/$name ($(cat "$dest"/src/*.rs | wc -l) lines of Rust)"
if $mini; then
  echo "$me: wrote proofs/{${lean_files[*]}}: $(awk -F'\t' '$2 == "generated"' "$dest/proofs.tsv" | wc -l) of $(($(wc -l < "$dest/proofs.tsv") - 1)) programs have a generated proof (generated/$name/proofs.tsv)"
fi
