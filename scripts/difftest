#!/usr/bin/env bash
# Compares pathos with the reference Ethos checker using the pinned harness.
#
#   scripts/difftest <gate> [difftest.py run options...]
#
# Gates (docs/brief.md, "Milestones"):
#   gate1    the 30 smallest regressions (docs/gates/gate1.txt)
#   tests    all of Ethos's regressions                      (gate 2)
#   gate3    the 10 smallest cvc5 proofs (docs/gates/gate3.txt)
#   proofs   all cvc5 proofs in the default corpus           (gate 4)
#   large    the corpus of large cvc5 proofs (1 MB or more)  (gate 6)
#   options  regressions and proofs, under each non-default
#            option and all of them together                 (gate 7)
#   all      regressions, proofs and large proofs, default options
#   perf     all, one job at a time, reference rerun         (gates 5, 6)
#   fuzz     replay the saved fuzzing findings in the harness's
#            tools/difftest/fuzz-findings/                   (gate 8)
#   cli      the harness's command-line cases, and the
#            regressions and proofs under the --stats options (gate 9)
#   snapshot regressions and proofs, pathos with a snapshot of the
#            CPC signature, under every option set; proofs with
#            broken snapshots; timings with and without     (gate 10)
#   eoc      eoc's driver with ethos-eoc and pathos-eoc, on the
#            test signatures and on logos's CPC     (gates 11 to 13)
#   bignum   arithmetic on numbers of 64 bits to a million bits, past
#            malachite's FFT threshold (docs/dependencies.md)
#
# Extra options go to `difftest.py run`, e.g. --filter, --show-all, --report.
# Exits 0 when pathos and the reference agree on every case, 1 otherwise,
# 2 when the setup is wrong.
#
# Memory: everything runs in a systemd scope capped at DIFFTEST_MEMORY_MAX
# (default: 60% of the machine's memory; e.g. 30G; "none" for no cap) and
# without swap. Ethos needs up to 24 GB on one large proof, and many jobs at
# once can need more than the machine has; with the cap the kernel then kills
# a checker inside the scope, not the desktop. The script reports that and
# exits 2, since the results are then wrong: rerun with a lower --jobs.
#
# The cap needs Linux with systemd; elsewhere (macOS, Windows under MSYS2)
# the gates run without one, which is fine for those that need no corpus.
#
# Needs ETHOS_HARNESS: a checkout of HARNESS_REPO at HARNESS_COMMIT (see
# difftest.env). Set it in the environment or in .difftest.local:
#   ETHOS_HARNESS=/path/to/ethos
# and bash (3.2 or later), git, cargo and Python 3.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../difftest.env
source "$root/difftest.env"
# .difftest.local holds local settings; one set in the environment wins.
env_harness="${ETHOS_HARNESS:-}"
if [[ -f "$root/.difftest.local" ]]; then
  # shellcheck disable=SC1091
  source "$root/.difftest.local"
fi
[[ -n "$env_harness" ]] && ETHOS_HARNESS="$env_harness"

# Windows (MSYS2): binaries end in .exe, and paths are written D:/dir so
# that both bash and native programs (Python, the checkers) read them.
exe=""
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    exe=".exe"
    root="$(cygpath -m "$root")"
    [[ -n "${ETHOS_HARNESS:-}" ]] && ETHOS_HARNESS="$(cygpath -m "$ETHOS_HARNESS")"
    ;;
esac
python="$(command -v python3 || command -v python || true)"

fail() { echo "scripts/difftest: $*" >&2; exit 2; }

# Re-run this script under the memory cap (see the header).
if [[ -z "${DIFFTEST_CAPPED:-}" ]]; then
  cap="${DIFFTEST_MEMORY_MAX:-}"
  [[ -n "$cap" || ! -r /proc/meminfo ]] ||
    cap="$(awk '/^MemTotal:/ { printf "%dM", $2 * 0.6 / 1024 }' /proc/meminfo)"
  if [[ "$cap" == none || ! -r /proc/meminfo ]]; then
    :
  elif systemd-run --user --scope -q -p MemoryMax=1G -p MemorySwapMax=0 \
      -p OOMPolicy=continue true 2>/dev/null; then
    DIFFTEST_CAPPED="$cap" exec systemd-run --user --scope -q \
      -p MemoryMax="$cap" -p MemorySwapMax=0 -p OOMPolicy=continue "$0" "$@"
  else
    echo "scripts/difftest: warning: no systemd user scope with a memory cap here," \
      "running without a memory cap" >&2
  fi
fi

# Exits with the given status, or with 2 if the kernel killed a process of
# this run at the memory cap.
finish() {
  local rc="$1" events kills=0
  if [[ -n "${DIFFTEST_CAPPED:-}" ]]; then
    events="/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup | head -1)/memory.events"
    [[ -r "$events" ]] && kills="$(awk '$1 == "oom_kill" { print $2 }' "$events")"
    [[ "${kills:-0}" -gt 0 ]] &&
      fail "the kernel killed $kills process(es) at the memory cap of" \
        "$DIFFTEST_CAPPED, so the results above are wrong; rerun with a" \
        "lower --jobs (or set DIFFTEST_MEMORY_MAX)"
  fi
  exit "$rc"
}

[[ $# -ge 1 ]] || fail "usage: scripts/difftest gate1|tests|gate3|proofs|large|options|all|perf|fuzz|cli|snapshot|eoc|bignum [options]"
[[ -n "$python" ]] || fail "no python3 or python in PATH"
gate="$1"; shift

[[ -n "${ETHOS_HARNESS:-}" ]] ||
  fail "set ETHOS_HARNESS to a checkout of $HARNESS_REPO at $HARNESS_COMMIT"
head="$(git -C "$ETHOS_HARNESS" rev-parse HEAD)"
[[ "$head" == "$HARNESS_COMMIT" ]] ||
  fail "$ETHOS_HARNESS is at $head, expected $HARNESS_COMMIT"
git -C "$ETHOS_HARNESS" diff --quiet HEAD -- tools/difftest tests ||
  fail "$ETHOS_HARNESS has local changes in tools/difftest or tests"

dt="$ETHOS_HARNESS/tools/difftest"
ref="$dt/work/ref/${REFERENCE_REV:0:12}/build/src/ethos$exe"
[[ -x "$ref" ]] ||
  fail "no reference binary; run: $dt/difftest.py build-ref $REFERENCE_REV"

corpus="$dt/work/corpus"
large="$dt/work/corpus-large"
check_corpus() {
  local dir="$1" how="$2"
  [[ -f "$dir/MANIFEST.json" ]] ||
    fail "no corpus in $dir; see $dt/README.md, \"$how\""
  local rev
  rev="$("$python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["cvc5_revision"])' "$dir/MANIFEST.json")"
  [[ "$rev" == "$CVC5_REV" ]] ||
    fail "$dir was made with cvc5 $rev, expected $CVC5_REV"
}
case "$gate" in gate3|proofs|options|all|perf|cli|snapshot) check_corpus "$corpus" "The proof corpus" ;; esac
case "$gate" in large|all|perf) check_corpus "$large" "A corpus of large proofs" ;; esac

# Builds the regex for --filter from a list of file names.
filter_from() {
  local prefix="$1" file="$2"
  "$python" - "$prefix" "$file" <<'EOF'
import re, sys
prefix, path = sys.argv[1], sys.argv[2]
names = [l.strip() for l in open(path) if l.strip() and not l.startswith("#")]
print("^(" + "|".join(re.escape(prefix + n) for n in names) + ")$")
EOF
}

args=()
case "$gate" in
  gate1)  args=(--tests "$ETHOS_HARNESS/tests"
                --filter "$(filter_from tests/ "$root/docs/gates/gate1.txt")") ;;
  tests)  args=(--tests "$ETHOS_HARNESS/tests") ;;
  gate3)  args=(--corpus "$corpus"
                --filter "$(filter_from corpus/ "$root/docs/gates/gate3.txt")") ;;
  proofs) args=(--corpus "$corpus") ;;
  large)  args=(--corpus "$large" --timeout "$LARGE_TIMEOUT") ;;
  options) args=(--tests "$ETHOS_HARNESS/tests" --corpus "$corpus"
                --all-option-sets --timeout "$OPTIONS_TIMEOUT") ;;
  all)    args=(--tests "$ETHOS_HARNESS/tests" --corpus "$corpus"
                --corpus "$large" --timeout "$LARGE_TIMEOUT") ;;
  perf)   args=(--tests "$ETHOS_HARNESS/tests" --corpus "$corpus"
                --corpus "$large" --timeout "$LARGE_TIMEOUT"
                --jobs 1 --no-cache) ;;
  cli)    args=(--cli --tests "$ETHOS_HARNESS/tests" --corpus "$corpus"
                --stats-option-sets) ;;
  bignum) args=(--bignum) ;;
  fuzz|snapshot|eoc) ;;
  *) fail "unknown gate: $gate" ;;
esac

cargo build --locked --release --quiet --manifest-path "$root/Cargo.toml" --bin pathos-eo
cand="$root/target/release/pathos-eo$exe"

if [[ "$gate" == eoc ]]; then
  refsrc="$dt/work/ref/${REFERENCE_REV:0:12}/src"
  refeoc="$dt/work/ref/${REFERENCE_REV:0:12}/build-eoc/ethos-eoc$exe"
  [[ -x "$refeoc" ]] ||
    fail "no reference ethos-eoc; run: $dt/difftest.py build-ref $REFERENCE_REV --eoc"
  logos="$dt/work/logos"
  [[ -d "$logos/.git" ]] ||
    fail "no logos checkout; run: git clone $LOGOS_REPO $logos && git -C $logos checkout $LOGOS_REV"
  lhead="$(git -C "$logos" rev-parse HEAD)"
  [[ "$lhead" == "$LOGOS_REV" ]] || fail "$logos is at $lhead, expected $LOGOS_REV"
  git -C "$logos" diff --quiet HEAD || fail "$logos has local changes"
  cargo build --locked --release --quiet --manifest-path "$root/Cargo.toml" --bin pathos-eoc
  rc=0
  "$python" "$dt/difftest.py" eoc --ref "$refeoc" --cand "$root/target/release/pathos-eoc$exe" \
    --src "$refsrc" --logos "$logos" "$@" || rc=$?
  finish $rc
fi

if [[ "$gate" == snapshot ]]; then
  snap="$root/target/difftest/snapshot"
  mkdir -p "$snap"
  "$cand" --write-snapshot="$snap/cpc.snap" "$corpus/cpc/Cpc.eo" ||
    fail "pathos-eo --write-snapshot failed"
  # Broken snapshots, which pathos must ignore: the first half, every 97th
  # byte flipped, and an empty file.
  head -c "$(( $(stat -c %s "$snap/cpc.snap") / 2 ))" "$snap/cpc.snap" > "$snap/truncated.snap"
  "$python" -c '
import sys
data = bytearray(open(sys.argv[1], "rb").read())
for i in range(0, len(data), 97):
    data[i] ^= 0x5a
open(sys.argv[2], "wb").write(data)
' "$snap/cpc.snap" "$snap/corrupt.snap"
  : > "$snap/empty.snap"
  rc=0
  echo "== with the snapshot: regressions and proofs, every option set"
  "$python" "$dt/difftest.py" run --ref "$ref" --cand "$cand" \
    --tests "$ETHOS_HARNESS/tests" --corpus "$corpus" --all-option-sets \
    --timeout "$OPTIONS_TIMEOUT" --cand-options="--snapshot=$snap/cpc.snap" \
    "$@" || rc=1
  for broken in truncated corrupt empty; do
    echo "== with the $broken snapshot: proofs"
    "$python" "$dt/difftest.py" run --ref "$ref" --cand "$cand" --corpus "$corpus" \
      --cand-options="--snapshot=$snap/$broken.snap" "$@" || rc=1
  done
  echo "== the candidate's time on the proofs, one job at a time:" \
    "without, then with the snapshot"
  for with in "" "--snapshot=$snap/cpc.snap"; do
    "$python" "$dt/difftest.py" run --ref "$ref" --cand "$cand" --corpus "$corpus" \
      --jobs 1 --quiet --show 0 ${with:+--cand-options="$with"} |
      grep "^time over" || rc=1
  done
  finish $rc
fi

if [[ "$gate" == fuzz ]]; then
  # Findings from proof seeds need the corpus; without it they are skipped.
  replay=(--tests "$ETHOS_HARNESS/tests")
  [[ -f "$corpus/MANIFEST.json" ]] && replay+=(--corpus "$corpus")
  rc=0
  for findings in "$dt"/fuzz-findings/*/; do
    echo "== ${findings%/}"
    "$python" "$dt/difftest.py" fuzz-replay --ref "$ref" --cand "$cand" \
      --findings "$findings" "${replay[@]}" "$@" || rc=1
  done
  finish $rc
fi

rc=0
"$python" "$dt/difftest.py" run --ref "$ref" --cand "$cand" \
  "${args[@]}" "$@" || rc=$?
finish $rc
