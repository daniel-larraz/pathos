# What proofs/ is built from, as difftest.env says it for the comparisons
# with Ethos. scripts/proofs-build checks that the other places that name
# these (lakefile.toml, lake-manifest.json, lean-toolchain,
# scripts/aeneas-setup, generated/cpcmini-checker/GENERATED.md) agree.

# Lean, and the Mathlib tag for it. logos is at this version itself
# (since cvc5/logos#518); Aeneas's Lean library (v4.36.0-rc2) is built at
# it here.
LEAN_VERSION=v4.36.0
MATHLIB_REV=fc4f59e577feb1a4956671bc04ac18aaaf8cd842

# Aeneas, for its Lean library (backends/lean), and the Charon it pins:
# the commits scripts/aeneas-setup installs, which wrote the Lean of the
# checker.
AENEAS_REPO=https://github.com/AeneasVerif/aeneas
AENEAS_REV=1dc8ad31b1b062a77c50e29144a6c7bba955fa09
CHARON_REV=454586e9b770231e66d2062993e632dfc06463e2

# logos: the revision whose CpcMini the proofs are about, which is the one
# generated/cpcmini-checker is generated from.
LOGOS_PROOFS_REPO=https://github.com/cvc5/logos
LOGOS_PROOFS_REV=241160d8f66201f08b79a62a557778c9d111a4b6
