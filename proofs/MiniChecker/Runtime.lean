    let i ← eostring.EoString.len s
    if i = 1#usize
    then
      let s1 ← eostring.EoString.code_points s
      let i1 ← Slice.index_usize s1 0#usize
      let i2 ← num.Integer.Insts.CoreConvertFromU32.from i1
      ok (some (lit.Lit.Numeral i2))
