    Source: 'src/lit.rs', lines 367:4-380:5 -/
def lit.Lit.evaluate_to_string
  (first : lit.Lit) : Result (Option lit.Lit) := do
  match first with
  | lit.Lit.Boolean _ => ok none
  | lit.Lit.Numeral i =>
    let b ← num.Integer.fits_u32 i
    if b
    then
      let i1 ← num.Integer.to_u32 i
      if i1 < eostring.NUM_CODES
      then
        let y ←
          lift (Std.Array.to_slice (Array.make 1#usize [ i1 ] : Array Std.U32
            1#usize))
        let ret := alloc.slice.Slice.into_vec y
        let es ← eostring.EoString.from_code_points ret
        ok (some (lit.Lit.Str es))
      else ok none
    else ok none
  | lit.Lit.Decimal _ => ok none
  | lit.Lit.Rational _ => ok none
  | lit.Lit.Hex _ => ok none
  | lit.Lit.Binary _ => ok none
  | lit.Lit.Str _ =>
    let l ← lit.Lit.Insts.CoreCloneClone.clone first
    ok (some l)

