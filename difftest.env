# What pathos is checked against. Change these only deliberately: they define
# what "matches Ethos" means. See docs/brief.md, "The harness".

# The differential testing harness: tools/difftest in this repository/commit.
HARNESS_REPO=https://github.com/daniel-larraz/ethos
HARNESS_COMMIT=a2c80fdccf0ea1275ac0a1d16007f0edcf8f544b

# The Ethos revision pathos must behave like (cvc5/ethos main, with PR #223).
REFERENCE_REV=9217112fc9b159ae530b6b2a02d6ed08e84d28d0

# The cvc5 revision the proof corpus was generated with.
CVC5_REV=2107a00359cb4007c79d6231575d6a3558022541

# Seconds per binary per case, where the default 120 is too short. Ethos takes
# about 400 s on the largest proof (453 MB), and 179 s on one option run that
# prints 1.77 GB of error output under --no-print-dag.
LARGE_TIMEOUT=1800
OPTIONS_TIMEOUT=600
