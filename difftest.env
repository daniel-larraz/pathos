# What pathos is checked against. Change these only deliberately: they define
# what "matches Ethos" means. See docs/brief.md, "The harness".

# The differential testing harness: tools/difftest in this repository/commit.
HARNESS_REPO=https://github.com/daniel-larraz/ethos
HARNESS_COMMIT=bc9b9ca12e98febfd4f9b3b074c064d1a1df4d1b

# The Ethos revision pathos must behave like: cvc5/ethos main, with #280
# (rust-meta for Charon and Aeneas), #282 (fallback cases, parallel bind),
# #283 (CI), #286 (stuckness through function types), #287 (rust-meta's
# literals as values) and #289 (the trace of the generated code). Its
# checker (src/) is that of e51f527c, the reference before; the stages
# pathos-eoc reimplements follow #282, #286 and #289's lean-meta. The same
# revision generates both compiled checkers (scripts/generate-cpc). Since
# 4c6b30e8 it also has #291 (the runtime's arithmetic), #292 (define-fun in
# reference files), #284 (the configurable maximum code point, which pathos
# mirrors) and #293 (the checker's 4 GiB stack); #284 and #292 change the
# checker (src/).
REFERENCE_REV=4c6b30e8111387febdc56d6a6b8b88646e872e6e

# The cvc5 revision the proof corpus was generated with.
CVC5_REV=2107a00359cb4007c79d6231575d6a3558022541

# Seconds per binary per case, where the default 120 is too short. Ethos takes
# about 400 s on the largest proof (453 MB), and 179 s on one option run that
# prints 1.77 GB of error output under --no-print-dag.
LARGE_TIMEOUT=1800
OPTIONS_TIMEOUT=600

# logos, the verified checker that compiles CPC with eoc: its signature and
# semantics are inputs of the eoc gate (milestone 11), which compiles them
# with REFERENCE_REV's ethos-eoc and pathos-eoc, and of both compiled
# checkers (scripts/generate-cpc) and the proofs (proofs/pins.env). logos
# main at this revision (#520 and #526) pins Ethos at c75bebde (#284);
# REFERENCE_REV adds #293, which changes only the rust-meta runtime's stack.
LOGOS_REPO=/home/daniel/Projects/cvc5/logos
LOGOS_REV=d4c919132867ffe4fb06ff622d91e9b6cec4734b

# The eoc gate's own pins: the Ethos whose ethos-eoc pathos-eoc is compared
# with, and the logos whose CPC it compiles. pathos-eoc is a lower priority
# than pathos, so these may stay behind REFERENCE_REV and LOGOS_REV while the
# checker gates move on; they move together, since a logos is written for
# the eoc of the Ethos it pins. Only the eoc gate uses them (scripts/difftest
# eoc, CI's ethos-eoc job); unset, they are REFERENCE_REV and LOGOS_REV.
EOC_REFERENCE_REV=bde41a79a3fb99d41012efa1f0d2c6c7635448a3
EOC_LOGOS_REV=bdcbd95f615627b26b6ebabc0f584e5230b0bf1f
