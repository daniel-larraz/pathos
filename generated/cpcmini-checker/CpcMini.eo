; trim-defs: symm contra refl scope trans and =>
; #trim-defs: 31
(declare-const not (-> Bool Bool))
(declare-const and (-> Bool Bool Bool) :right-assoc-nil true)
(declare-const => (-> Bool Bool Bool) :right-assoc)
(declare-parameterized-const = ((A Type :implicit)) (-> A A Bool)
  :chainable and)
(declare-rule scope ((F Bool) (G Bool))
  :assumption F
  :premises (G)
  :conclusion (=> F G)
)
(declare-const Int Type)
(declare-const Real Type)
(declare-consts <numeral> Int)
(declare-consts <rational> Real)
(declare-rule contra ((F Bool))
  :premises (F (not F))
  :conclusion false
)
(declare-const BitVec (-> Int Type))
(declare-consts <binary> (BitVec (eo::len eo::self)))
(declare-const Seq (-> Type Type))
(declare-const Char Type)
(define String () (Seq Char))
(declare-consts <string> String)
(declare-rule refl ((T Type) (t T))
  :args (t)
  :conclusion (= t t)
)
(program $mk_symm ((T Type) (t1 T) (t2 T))
  :signature (Bool) Bool
  (
  (($mk_symm (= t1 t2))       (= t2 t1))
  (($mk_symm (not (= t1 t2))) (not (= t2 t1)))
  )
)
(declare-rule symm ((F Bool))
  :premises (F)
  :conclusion ($mk_symm F)
)
(program $mk_trans ((U Type) (t1 U) (t2 U) (t3 U) (t4 U) (tail Bool :list))
  :signature (U U Bool) Bool
  (
  (($mk_trans t1 t2 (and (= t3 t4) tail))
    (eo::requires t2 t3 ($mk_trans t1 t4 tail)))
  (($mk_trans t1 t2 true) (= t1 t2))
  )
)
(declare-rule trans ((T Type) (t1 T) (t2 T) (tail Bool :list))
  :premise-list (and (= t1 t2) tail) and
  :conclusion ($mk_trans t1 t2 tail)
)
